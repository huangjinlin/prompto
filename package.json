{
  "name": "prompto",
  "displayName": "Prompto - AI Prompt Manager",
  "description": "Keep your prompts tidy, searchable, and ready to use — all from a clean file-based workflow in AI Code Editors.",
  "version": "1.0.9",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "prompts",
    "ai",
    "chat",
    "productivity",
    "markdown"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "prompto.usePrompt",
        "title": "Prompto: Use Prompt",
        "icon": "$(play)"
      },
      {
        "command": "prompto.prefillActiveTerminal",
        "title": "Prompto: Prefill Active Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "prompto.addPrompt",
        "title": "Prompto: Add New Prompt",
        "icon": "$(add)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "promptoTree",
          "name": "Prompto",
          "when": "true"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "prompto.addPrompt",
          "when": "view == promptoTree",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "prompto.usePrompt",
          "when": "view == promptoTree && viewItem == prompt",
          "group": "prompt@1"
        },
        {
          "command": "prompto.prefillActiveTerminal",
          "when": "view == promptoTree && viewItem == prompt",
          "group": "prompt@2"
        }
      ],
      "commandPalette": [
        {
          "command": "prompto.usePrompt",
          "when": "true"
        },
        {
          "command": "prompto.prefillActiveTerminal",
          "when": "true"
        },
        {
          "command": "prompto.addPrompt",
          "when": "true"
        }
      ]
    },
    "keybindings": [
      {
        "command": "prompto.usePrompt",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Prompto",
      "properties": {
        "prompto.outputMode": {
          "type": "string",
          "default": "chatPrefill",
          "enum": [
            "chatPrefill",
            "chatSubmit",
            "clipboard"
          ],
          "enumDescriptions": [
            "Fill the selected prompt into the configured chat target without sending it.",
            "Send the selected prompt immediately to the configured chat target.",
            "Copy the selected prompt to the clipboard."
          ],
          "markdownDescription": "Controls what happens after selecting a prompt with **Prompto: Use Prompt**."
        },
        "prompto.deliveryTarget": {
          "type": "string",
          "default": "githubCopilotChat",
          "enum": [
            "githubCopilotChat",
            "continue",
            "claudeCode"
          ],
          "enumDescriptions": [
            "Deliver prompts to GitHub Copilot Chat.",
            "Deliver prompts to Continue through its Prompto control command.",
            "Deliver prompts to the active terminal, intended for Claude Code."
          ],
          "markdownDescription": "Selects which chat surface receives prompts when **Prompto: Use Prompt** runs. Prompt metadata can override this with `deliveryTarget`."
        },
        "prompto.continueSessionId": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional Continue session ID to focus before Prompto delivers a prompt. Leave empty to use the current Continue session."
        },
        "prompto.continueSessionTitle": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional Continue session title to resolve before Prompto delivers a prompt. Used only when `prompto.continueSessionId` is empty, and must match exactly one Continue session title."
        },
        "prompto.promptsDirectory": {
          "type": "string",
          "default": ".prompto",
          "markdownDescription": "Workspace-relative folder that stores Prompto markdown prompt files."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "1.74.0",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "5.45.0",
    "@typescript-eslint/parser": "5.45.0",
    "eslint": "8.28.0",
    "typescript": "4.9.4",
    "@vscode/test-electron": "2.2.0",
    "vsce": "2.15.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/desenvolvweb/prompto"
  },
  "bugs": {
    "url": "https://github.com/desenvolvweb/prompto/issues"
  },
  "homepage": "https://github.com/desenvolvweb/prompto#readme",
  "author": {
    "name": "dpw",
    "email": "dpw@webfatorial.com"
  },
  "license": "WTFPL",
  "publisher": "dpw"
}
